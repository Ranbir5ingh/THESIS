# Supabase Postgres. Use a pooled/server connection string from Supabase Connect.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.pooler.supabase.com:5432/postgres?sslmode=require"
DB_POOL_MAX=10

# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Alpha Vantage — live global symbol search, quotes, fundamentals, daily/weekly history and news.
# Alpha Vantage currently documents a standard 25-request/day limit; THESIS caches responses to stretch the demo key.
ALPHA_VANTAGE_API_KEY=""

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
PORT=4000
