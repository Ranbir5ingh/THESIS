# Supabase Postgres. Use a pooled/server connection string from Supabase Connect.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.pooler.supabase.com:5432/postgres?sslmode=require"
DB_POOL_MAX=10

# Gemini — required for live AI thesis challenges.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Market data — Yahoo Finance is the primary provider and requires no API key.
# THESIS caches verified Yahoo responses in memory + Supabase/Postgres.
# No market-data API key is required for the default setup.

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
PORT=4000
